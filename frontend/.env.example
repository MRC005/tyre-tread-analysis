# Base URL of the FastAPI backend.
#
# Leave EMPTY for local development and phone testing. The Vite dev server proxies
# /api to the backend, so the browser sees one origin and CORS does not apply — which
# means a phone test needs only one HTTPS tunnel.
#
# Set this only for a real deployment, to the Render service URL:
#   VITE_API_BASE_URL=https://your-service.onrender.com
VITE_API_BASE_URL=
