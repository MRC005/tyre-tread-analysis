# Copy to .env for local development. Never commit .env.
# Every value below is non-secret configuration; this project has no API keys,
# no database credentials and no third-party tokens by design.

# --- Backend ---------------------------------------------------------------
# Artifact id the API serves. Pinned rather than "latest" so a deploy serves a
# known model and a rollback is a configuration change, not a retrain.
TYRETREAD_MODEL_ID=current

# Comma-separated allowed origins. Must list explicit origins in production:
# the API refuses to start with "*" when TYRETREAD_ENV=production, because a
# wildcard would let any site post a user's photograph to this backend.
TYRETREAD_CORS_ORIGINS=http://localhost:5173

# Upload ceiling in bytes. 12 MB comfortably holds a modern phone photograph;
# the pipeline reduces anything larger to 1600 px on the long edge anyway.
TYRETREAD_MAX_UPLOAD_BYTES=12582912

# Seconds a single inspection may run before the request is abandoned.
TYRETREAD_INSPECTION_TIMEOUT=20

TYRETREAD_LOG_LEVEL=INFO
TYRETREAD_ENV=development

# --- Paths (optional) ------------------------------------------------------
# Override when data or artifacts live outside the repository.
# TYRETREAD_DATA_DIR=/absolute/path/to/data
# TYRETREAD_ARTIFACT_DIR=/absolute/path/to/artifacts
